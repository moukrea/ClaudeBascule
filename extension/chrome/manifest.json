{
  "manifest_version": 3,
  "name": "Claude Bascule Connector",
  "version": "1.4.0",
  "description": "Lets Claude Bascule switch claude.ai in this browser together with Claude Code. Independent tool, not affiliated with Anthropic.",
  "permissions": ["cookies", "nativeMessaging", "tabs", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": ""
}
